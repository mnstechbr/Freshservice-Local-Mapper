dev-server.lock

# Logs
/logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Variáveis de ambiente (segredos). Só o modelo é versionado.
.env*
!.env.example

# Credenciais, tokens e chaves
/secrets/
*.pem
*.key
*.p12
*.pfx
*.dpapi
vault.enc.json
*credentials*.json
*token*.json

# Exportações e dados de clientes
/exports/
*.csv
*.xlsx

# Configuração local do Claude Code
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Sistema operacional / editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# Temporários
/tmp/
.tmp/
*.tmp

# Testes E2E, validação e relatórios do Playwright (dados de teste descartáveis, nunca versionar).
.e2e-data/
.qa-*/
test-results/
playwright-report/
blob-report/

# Arquivos internos preservados no computador, excluídos da distribuição pública.
