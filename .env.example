# Modelo de variáveis de ambiente. Copie para .env (não versionado) apenas se quiser sobrescrever
# os padrões. Não coloque segredos (API keys, tokens) neste arquivo.

# Diretório do banco SQLite. Vazio = padrão do sistema operacional:
#   Linux:   $XDG_DATA_HOME/freshservice-local-mapper (ou ~/.local/share/freshservice-local-mapper)
#   macOS:   ~/Library/Application Support/freshservice-local-mapper
#   Windows: %LOCALAPPDATA%\FreshserviceLocalMapper
# Caminho absoluto obrigatório. Não use public/, pasta temporária ou pasta sincronizada
# (OneDrive, Dropbox, Google Drive, iCloud).
FSLM_DATA_DIR=

# Porta do servidor (sempre em 127.0.0.1).
PORT=3000

# 1 = não abre o navegador automaticamente ao rodar pnpm dev / npm run dev.
FSLM_NO_BROWSER=0

# Desativa a telemetria do Next.js (os scripts já definem; mantido para referência).
NEXT_TELEMETRY_DISABLED=1
